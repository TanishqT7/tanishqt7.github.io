---
import { render } from 'astro:content';
import YouTubeFacade from './YouTubeFacade.astro';
import type { Video } from '../lib/videos';

interface Props { video: Video }
const { video } = Astro.props;
const { Content } = await render(video);
const { title, youtubeId, edits } = video.data;
---
<!-- Always exactly 4 children (video, title, edit tags, details): the grid rows depend on it. -->
<article class="card">
  <div class="frame">
    <YouTubeFacade id={youtubeId} title={title} />
  </div>

  <h3>{title}</h3>

  <ul class="edits">{edits.map((e) => <li>{e}</li>)}</ul>

  <details>
    <summary>How I edited this</summary>
    <div class="prose"><Content /></div>
  </details>
</article>