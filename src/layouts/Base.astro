---
import '../styles/global.css';
import { categories, getVideos, inCategory, url } from '../lib/videos';
import { NAME, CHANNEL_NAME, CHANNEL_URL, EMAIL } from '../lib/site';

interface Props { title?: string; description?: string }
const {
  title = `${NAME} | Video editor for tech creators`,
  description = 'Long-form talking head, motion graphics and drone edits for consumer tech channels.',
} = Astro.props;

const videos = await getVideos();
const navItems = categories.filter((c) => inCategory(videos, c.key).length > 0);
const home = url('/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="wrap masthead">
      <div class="id">
        <strong>{NAME}</strong>
        <span>Video editor</span>
      </div>
      <!-- Put your photo at public/profile.jpg (square, at least 300x300) -->
      <a class="avatar" href={home} aria-label="Home">
        <img src={url('/profile.jpg')} alt={NAME} width="176" height="176" />
      </a>
      <a class="id end" href={CHANNEL_URL} rel="noopener" aria-label={`${CHANNEL_NAME} on YouTube`}>
        <strong>{CHANNEL_NAME}</strong>
        <span>YouTube channel</span>
      </a>
    </header>

    <!-- The timeline ruler: section links sit on it, and the red playhead tracks your scroll -->
    <nav class="ruler" aria-label="Sections">
      <ul>
        {navItems.map((c) => <li><a href={`${home}#${c.key}`} style={`--c:${c.color}`}>{c.label}</a></li>)}
        <li><a href={`${home}#contact`}>Contact</a></li>
      </ul>
      <span class="playhead" aria-hidden="true"></span>
      <span class="tc" aria-hidden="true">00:00:00:00</span>
    </nav>

    <main><slot /></main>

    <footer class="contact" id="contact">
      <div class="wrap">
        <h2>Have a video to edit?</h2>
        <p>Tell me about the channel, the format and your usual turnaround. I'll reply within a day.</p>
        <div class="actions">
          <a class="btn primary" href={`mailto:${EMAIL}`}>Email me</a>
          <a class="btn" href={CHANNEL_URL} rel="noopener">My YouTube channel</a>
        </div>
      </div>
    </footer>

    <script>
      // Playhead: scroll progress becomes position on the ruler plus a timecode (60 fps, 7 minute "timeline").
      // The ruler link for the section you're in is highlighted, and scrolled into view on narrow screens.
      const ruler = document.querySelector<HTMLElement>('.ruler');
      const tc = document.querySelector<HTMLElement>('.tc');
      const list = ruler?.querySelector<HTMLElement>('ul');
      const FPS = 60;
      const TOTAL_SECONDS = 420;
      const pad = (n: number) => String(n).padStart(2, '0');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Ruler links that point at a section on this page
      const items = [...document.querySelectorAll<HTMLAnchorElement>('.ruler a')]
        .map((a) => ({ a, target: document.getElementById(a.hash.slice(1)) }))
        .filter((i): i is { a: HTMLAnchorElement; target: HTMLElement } => i.target !== null);
      let activeLink: HTMLAnchorElement | null = null;

      function updateActive() {
        const line = window.innerHeight * 0.35;
        let current: HTMLAnchorElement | null = null;
        for (const { a, target } of items) {
          if (target.getBoundingClientRect().top <= line) current = a;
        }
        if (current === activeLink) return;
        activeLink?.removeAttribute('aria-current');
        current?.setAttribute('aria-current', 'location');
        activeLink = current;
        if (current && list && list.scrollWidth > list.clientWidth) {
          const x = current.getBoundingClientRect().left - list.getBoundingClientRect().left + list.scrollLeft;
          list.scrollTo({ left: x - (list.clientWidth - current.offsetWidth) / 2, behavior: reduceMotion ? 'auto' : 'smooth' });
        }
      }

      function update() {
        if (!ruler) return;
        const doc = document.documentElement;
        const max = doc.scrollHeight - window.innerHeight;
        // Browsers often stop a few pixels short of the true bottom (fractional scroll positions, phone
        // toolbars sliding away), so anything within 3px of the end counts as the end.
        const atEnd = window.scrollY + window.innerHeight >= doc.scrollHeight - 3;
        const p = max <= 0 ? 0 : atEnd ? 1 : Math.min(1, Math.max(0, window.scrollY / max));
        ruler.style.setProperty('--p', p.toFixed(4));
        if (tc) {
          const frames = Math.round(p * TOTAL_SECONDS * FPS);
          const s = Math.floor(frames / FPS);
          tc.textContent = `00:${pad(Math.floor(s / 60))}:${pad(s % 60)}:${pad(frames % FPS)}`;
        }
        updateActive();
      }

      let queued = false;
      window.addEventListener('scroll', () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => { queued = false; update(); });
      }, { passive: true });
      window.addEventListener('resize', update);
      window.visualViewport?.addEventListener('resize', update); // phone toolbars showing/hiding
      update();
    </script>
  </body>
</html>