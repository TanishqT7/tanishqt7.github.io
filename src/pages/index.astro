---
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import { categories, getVideos, inCategory, homepagePicks, url } from '../lib/videos';
import { SHOWREEL_ID } from '../lib/site';

const videos = await getVideos();
const tracks = categories
  .map((c) => {
    const items = inCategory(videos, c.key);
    return { ...c, total: items.length, shown: homepagePicks(items, c.key) };
  })
  .filter((t) => t.total > 0); // hide empty sections

const showReel = Boolean(SHOWREEL_ID) || import.meta.env.DEV;
---
<Base>
  <section class="wrap intro">
    <h1>Long-form tech videos, edited to hold attention.</h1>
    <p>
      Talking-head edits for consumer tech channels: tight pacing, custom 3D backgrounds,
      motion graphics and sound design. Four years of making my own tech videos behind it.
    </p>
  </section>

  {showReel && (
    <section class="monitor" aria-labelledby="reel-heading">
      <h2 id="reel-heading" class="visually-hidden">Showreel</h2>
      <div class="frame">
        {SHOWREEL_ID
          ? <YouTubeFacade id={SHOWREEL_ID} title="Showreel" thumb="maxresdefault" eager />
          : <p class="placeholder">Showreel goes here. Set SHOWREEL_ID in src/lib/site.ts</p>}
      </div>
    </section>
  )}

  <div class="wrap tracks">
    {tracks.map((t, i) => (
      <section class="track" id={t.key} style={`--track:${t.color}`}>
        <div class="track-head">
          <span class="track-id">V{i + 1}</span>
          <h2>{t.label}</h2>
          <p class="count">{t.total} {t.total === 1 ? 'video' : 'videos'}</p>
        </div>
        <div class="track-body">
          <div class="rail">
            {t.shown.map((v) => <VideoCard video={v} />)}
          </div>
          {t.total > t.shown.length && (
            <a class="btn more" href={url(`/work/${t.key}/`)}>
              Load more {t.label.toLowerCase()} ({t.total} total)
            </a>
          )}
        </div>
      </section>
    ))}
  </div>
</Base>