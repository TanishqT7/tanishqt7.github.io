---
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import { categories, getVideos, inCategory, homepagePicks, url } from '../lib/videos';
import { SHOWREEL_ID, SHOWREEL_PLACEHOLDER } from '../lib/site';

const videos = await getVideos();
const tracks = categories
  .map((c) => {
    const items = inCategory(videos, c.key);
    return { ...c, total: items.length, shown: homepagePicks(items, c.key) };
  })
  .filter((t) => t.total > 0); // hide empty sections

const showReel = Boolean(SHOWREEL_ID) || Boolean(SHOWREEL_PLACEHOLDER) || import.meta.env.DEV;
---
<Base>
  <section class="wrap intro">
    <h1>Freelance video editor for long-form, talking-head content.</h1>
    <p>
      I'm Tanishq, a freelance video editor with 4+ years of experience in long-form content.
      I handle the full post-production: tight cuts and pacing, color grading, VFX, sound design
      and motion graphics. Clear, polished and easy to watch, on any platform.
    </p>
    <ul class="edits services" aria-label="What I edit">
      <li>Talking head</li>
      <li>Podcasts</li>
      <li>Explainers</li>
      <li>Education</li>
      <li>Screen recording</li>
      <li>Social media content</li>
    </ul>
  </section>

  {showReel && (
    <section class="monitor" aria-labelledby="reel-heading">
      <h2 id="reel-heading" class="visually-hidden">Showreel</h2>
      <div class="frame">
        {SHOWREEL_ID
          ? <YouTubeFacade id={SHOWREEL_ID} title="Showreel" thumb="maxresdefault" eager />
          : SHOWREEL_PLACEHOLDER
            ? <img class="under-construction" src={url(`/${SHOWREEL_PLACEHOLDER}`)} alt="Showreel under construction" />
            : <p class="placeholder">Showreel goes here. Set SHOWREEL_ID in src/lib/site.ts</p>}
      </div>
    </section>
  )}

  <div class="wrap tracks">
    {tracks.map((t, i) => (
      <section class="track" id={t.key} style={`--track:${t.color}`}>
        <div class="track-head">
          <span class="track-id">V{i + 1}</span>
          <h2>{t.label}</h2>
          <p class="count">{t.total} {t.total === 1 ? 'video' : 'videos'}</p>
        </div>
        <div class="track-body">
          <div class="rail">
            {t.shown.map((v) => <VideoCard video={v} />)}
          </div>
          {t.total > t.shown.length && (
            <a class="btn more" href={url(`/work/${t.key}/`)}>
              Load more {t.label.toLowerCase()} ({t.total} total)
            </a>
          )}
        </div>
      </section>
    ))}
  </div>
</Base>